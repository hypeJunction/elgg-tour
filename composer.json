{
    "name": "hypejunction/tour",
    "description": "Manage and display feature tours powered by Hopscotch or Joyride",
    "type": "elgg-plugin",
    "keywords": [
        "elgg",
        "plugin",
        "tour",
        "joyride",
        "hopscotch"
    ],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Juho Jaakkola",
            "email": "juho@elgg.org"
        },
        {
            "name": "Ismayil Khayredinov",
            "email": "ismayil.khayredinov@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "elgg/elgg": "~7.0.0",
        "composer/installers": "^2.0",
        "ext-intl": "*"
    },
    "autoload": {
        "psr-4": {
            "Tour\\": "classes/Tour/"
        }
    },
    "extra": {
        "installer-name": "tour",
        "elgg-plugin": {
            "id": "tour"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true
        }
    }
}
